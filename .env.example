# Blink Account Credentials
# These can be obtained using the 'account' command with --print-exports
BLINK_REGION=u011
BLINK_TOKEN=your_blink_api_token_here
BLINK_DEVICE_TYPE=owl
BLINK_ACCOUNT_ID=12345
BLINK_NETWORK_ID=67890
BLINK_CAMERA_ID=11111

# Output Configuration
# Options: ffplay (default, opens video player) or rtsp (publishes to RTSP server)
LIVEVIEW_OUTPUT=rtsp

# RTSP Server Configuration
# Required when LIVEVIEW_OUTPUT=rtsp
# Format: rtsp://hostname:port
RTSP_BASE_URL=rtsp://mediamtx:8554
